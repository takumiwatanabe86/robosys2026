import sys
import argparse
from decimal import Decimal, ROUND_HALF_UP


def main():

    parser = argparse.ArgumentParser(
        description="Round numbers from standard input."
    )
    parser.add_argument(
        "-p", "--place",
        type=int,
        default=2,
        help="rounding place (default: 2)"
    )
    args = parser.parse_args()

    for line_number, line in enumerate(sys.stdin, start=1):
        value = line.strip()

        if not value:
            continue

        try:
            number = Decimal(value)
            if not number.is_finite():
                raise ValueError
        except (ValueError, ArithmeticError):
            print(
                f"cutnumber: invalid number on line {line_number}",
                file=sys.stderr
            )
            return 1

        unit = Decimal(1).scaleb(args.place)
        rounded = (number / unit).quantize(
            Decimal("1"),
            rounding=ROUND_HALF_UP
        ) * unit

        print(format(rounded, "f").rstrip("0").rstrip(".")
              if "." in format(rounded, "f") else format(rounded, "f"))

    return 0

if __name__ == "__main__":
    sys.exit(main())
