import sys
import argparse
from decimal import (
    Decimal,
    ROUND_HALF_UP,
    ROUND_CEILING,
    ROUND_FLOOR,
)


def main():
    parser = argparse.ArgumentParser(
        description="Round numbers from standard input."
    )
    parser.add_argument(
        "-p", "--place",
        type=int,
        default=2,
        help="rounding place (default: 2)"
    )
    parser.add_argument(
        "-m", "--method",
        choices=["half_up", "ceil", "floor"],
        default="half_up",
        help="rounding method (default: half_up)"
    )
    args = parser.parse_args()

    rounding_modes = {
        "half_up": ROUND_HALF_UP,
        "ceil": ROUND_CEILING,
        "floor": ROUND_FLOOR,
    }

    for line_number, line in enumerate(sys.stdin, start=1):
        value = line.strip()

        if not value:
            continue

        try:
            number = Decimal(value)
            if not number.is_finite():
                raise ValueError
        except (ValueError, ArithmeticError):
            print(
                f"cutnumber: invalid number on line {line_number}",
                file=sys.stderr
            )
            return 1

        unit = Decimal(1).scaleb(args.place)
        rounded = (number / unit).quantize(
            Decimal("1"),
             rounding=rounding_modes[args.method]
        ) * unit

        result = format(rounded, "f")
        if "." in result:
            result = result.rstrip("0").rstrip(".")

        print(result)

    return 0

if __name__ == "__main__":
    sys.exit(main())
